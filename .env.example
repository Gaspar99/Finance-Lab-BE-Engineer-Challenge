# GCP Project
GCP_PROJECT_ID=your-project-id

# Cloud Storage
GCS_BUCKET_NAME=your-bucket-name

# Firestore
FIRESTORE_DATABASE=your-firestore-database-id

# Secret Manager — name of the secret that holds the API key
SECRET_NAME=api-key

# Document AI — processor ID
DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# Vertex AI — location for Gemini model (Gemini only available in US regions)
VERTEX_AI_LOCATION=us-central1

# Local development only — path to the service account key JSON
# Remove this in production (Cloud Run uses the attached service account)
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json
